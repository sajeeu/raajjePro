// RaajjePro database schema.
//
// Conventions every model follows (plan §2 Architecture Decisions):
//   - UUID primary key:      id String @id @default(uuid()) @db.Uuid
//   - integer laari money:   ...Laari Int   — MVR × 100, never Float or Decimal
//   - soft delete:           a status/visibility field; no row is ever DELETEd
//   - snake_case in the DB:  @@map / @map, camelCase in code
// Phase 2 encodes these as reusable base patterns. Phase 2 adds the
// infrastructure tables below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per scheduled job, holding when it last fired. The Phase 0 no-op
/// job upserts its row every minute, which is how "the runner is running" is
/// observed — by a query, not by reading a log. Upserting keeps the table at
/// one row per job with nothing to prune, so the no-delete rule holds here too.
model JobHeartbeat {
  id      String   @id @default(uuid()) @db.Uuid
  jobName String   @unique @map("job_name")
  firedAt DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)

  @@map("job_heartbeat")
}

// ---------------------------------------------------------------------------
// Phase 2 — core infrastructure
// ---------------------------------------------------------------------------

/// Rate-limit window counters. UNLOGGED (set in the migration): out of the WAL
/// and PITR stream, which is right for ephemeral state — and means an unclean
/// shutdown truncates the table and every limit fails open for one window.
/// Rows are keyed per (scope, subject) and reused across windows, never deleted.
model RateLimitCounter {
  key             String   @id
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)

  @@map("rate_limit_counter")
}

enum IdempotencyStatus {
  in_progress
  completed
  abandoned

  @@map("idempotency_status")
}

/// One row per (subject, operation, client key). A repeat with the same body
/// replays response_status/response_body; nothing here is ever deleted.
model IdempotencyRecord {
  id              String            @id @default(uuid()) @db.Uuid
  subject         String
  operation       String
  clientKey       String            @map("client_key")
  requestHash     String            @map("request_hash")
  status          IdempotencyStatus
  responseStatus  Int?              @map("response_status")
  responseHeaders Json?             @map("response_headers")
  responseBody    Json?             @map("response_body")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)

  @@unique([subject, operation, clientKey])
  @@map("idempotency_record")
}

enum AdminStatus {
  active
  disabled

  @@map("admin_status")
}

/// Admin identity (plan §Phase 2). One role in v1. `status` is the soft-delete
/// field. The TOTP secret is AES-256-GCM ciphertext; null until enrolment starts.
model AdminUser {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique
  passwordHash        String      @map("password_hash")
  role                String      @default("admin")
  status              AdminStatus @default(active)
  totpSecretEncrypted String?     @map("totp_secret_encrypted")
  totpEnrolledAt      DateTime?   @map("totp_enrolled_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      AdminSession[]
  recoveryCodes AdminRecoveryCode[]

  @@map("admin_user")
}

enum SessionRevokedReason {
  logout
  force_logout
  idle_timeout
  absolute_expiry
  mfa_failures
  password_change

  @@map("session_revoked_reason")
}

/// A browser session. The cookie holds a random token; only its sha256 is here.
model AdminSession {
  id                String                @id @default(uuid()) @db.Uuid
  adminId           String                @map("admin_id") @db.Uuid
  admin             AdminUser             @relation(fields: [adminId], references: [id])
  tokenHash         String                @unique @map("token_hash")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime              @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(6)
  mfaVerifiedAt     DateTime?             @map("mfa_verified_at") @db.Timestamptz(6)
  reauthenticatedAt DateTime?             @map("reauthenticated_at") @db.Timestamptz(6)
  mfaFailures       Int                   @default(0) @map("mfa_failures")
  ipAddress         String                @map("ip_address")
  userAgent         String                @map("user_agent")
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     SessionRevokedReason? @map("revoked_reason")

  @@index([adminId, revokedAt])
  @@map("admin_session")
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  admin     AdminUser @relation(fields: [adminId], references: [id])
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([adminId, codeHash])
  @@map("admin_recovery_code")
}

enum AuditActorType {
  admin
  user
  system

  @@map("audit_actor_type")
}

/// Append-only. Every admin action: who, when, what, on what, why (plan
/// §Phase 2). `metadata` holds IDs and enums only — never an email, phone or
/// document. No code path updates or deletes a row.
model AuditLogEntry {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String         @map("target_id")
  reason     String
  metadata   Json?
  requestId  String?        @map("request_id")
  ipAddress  String?        @map("ip_address")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log_entry")
}

enum EmailChannel {
  otp
  notification
  marketing

  @@map("email_channel")
}

enum EmailMessageStatus {
  queued
  sent
  failed
  suppressed
  delivered
  bounced
  complained
  rejected
  delivery_delayed

  @@map("email_message_status")
}

/// Per-message delivery log — SES has no searchable console, so this is what
/// answers "did this user actually receive it?" (plan §Phase 3c, §Phase 10b).
model EmailMessage {
  id                String             @id @default(uuid()) @db.Uuid
  channel           EmailChannel
  toAddress         String             @map("to_address")
  recipientUserId   String?            @map("recipient_user_id") @db.Uuid
  subject           String
  status            EmailMessageStatus
  configurationSet  String?            @map("configuration_set")
  providerMessageId String?            @unique @map("provider_message_id")
  failureReason     String?            @map("failure_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  lastEventAt       DateTime?          @map("last_event_at") @db.Timestamptz(6)

  events         EmailEvent[]
  otps           EmailOtp[]
  pushDispatches PushDispatch[]

  @@index([toAddress, createdAt])
  @@index([recipientUserId, createdAt])
  @@map("email_message")
}

/// One row per SNS notification received from the SES event destination.
/// `snsMessageId` is unique because SNS retries.
model EmailEvent {
  id                String        @id @default(uuid()) @db.Uuid
  snsMessageId      String        @unique @map("sns_message_id")
  messageId         String?       @map("message_id") @db.Uuid
  message           EmailMessage? @relation(fields: [messageId], references: [id])
  providerMessageId String?       @map("provider_message_id")
  eventType         String        @map("event_type")
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(6)
  payload           Json
  receivedAt        DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([providerMessageId])
  @@map("email_event")
}

enum SuppressionReason {
  hard_bounce
  complaint
  manual

  @@map("suppression_reason")
}

/// Addresses we must not send to. Active while lifted_at IS NULL — a partial
/// unique index on that condition is added by hand in the migration. Lifting
/// (Phase 10b) sets lifted_at; nothing is deleted.
model EmailSuppression {
  id              String            @id @default(uuid()) @db.Uuid
  address         String
  reason          SuppressionReason
  sourceEventId   String?           @map("source_event_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  liftedAt        DateTime?         @map("lifted_at") @db.Timestamptz(6)
  liftedByAdminId String?           @map("lifted_by_admin_id") @db.Uuid
  liftReason      String?           @map("lift_reason")

  @@index([address])
  @@map("email_suppression")
}

// ---------------------------------------------------------------------------
// Phase 3 — identity & authentication
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  frozen
  anonymised

  @@map("user_status")
}

/// A customer or provider account (plan §Phase 3). `status` is the soft-delete
/// field: `frozen` after a deletion request, `anonymised` when the job has
/// replaced name, email and phone. `phoneE164` is deliberately NOT unique —
/// exclusivity begins at Bronze (§0.0 item 8a) and is enforced in the service.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash        String     @map("password_hash")
  fullName            String     @map("full_name")
  phoneE164           String?    @map("phone_e164")
  phoneDialCode       String?    @map("phone_dial_code")
  status              UserStatus @default(active)
  termsAcceptedAt     DateTime   @map("terms_accepted_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  deletionDeadlineAt  DateTime?  @map("deletion_deadline_at") @db.Timestamptz(6)
  anonymisedAt        DateTime?  @map("anonymised_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Phase 3c. The OS-level answer, reported by the app. Account-level rather
  /// than per-device: the fallback question is "can a push reach this person
  /// at all", and one device saying no while another says yes is answered by
  /// the live device registrations, not by this field.
  pushPermission          PushPermission @default(unknown) @map("push_permission")
  pushPermissionUpdatedAt DateTime?      @map("push_permission_updated_at") @db.Timestamptz(6)

  providerProfile ProviderProfile?
  sessions        UserSession[]
  otps            EmailOtp[]
  deviceTokens    DeviceToken[]
  pushDispatches  PushDispatch[]

  @@index([phoneE164])
  @@index([status, deletionDeadlineAt])
  @@map("app_user")
}

enum VerificationTier {
  none
  bronze
  silver
  gold

  @@map("verification_tier")
}

enum VerificationStatus {
  unverified
  pending
  verified

  @@map("verification_status")
}

/// §Phase 6a, Round 21. How a provider offers services — and **not
/// cosmetic**: §1e reads it to decide what Gold verification asks for (an
/// individual supplies personal ID, a business supplies registration
/// documents), and §1g's Maldivian-owned *business* attribute hangs from it.
enum ProviderType {
  individual
  business

  @@map("provider_type")
}

/// The provider half of an account. Phase 3 created it with only the columns
/// Phase 3 reads — Business/Trade Name from the Register provider variant,
/// and the tier the Bronze-uniqueness rule checks. Phase 5 adds the rest
/// additively (plan §Phase 5). `verificationTier` is what the badge renders;
/// `verificationStatus` is only the review state of a pending submission.
///
/// Two things are deliberately **not** columns here:
///
///   - **A phone number.** §Phase 5 stores "exactly one phone number" and that
///     is `User.phoneE164`, captured in Phase 3. A second copy on this row
///     would be a second thing to protect, and §1c allows exactly one endpoint
///     in the whole system to return a number to another user.
///   - **A public visibility flag.** §1a: visibility is *derived* from the
///     published-listing count, never stored. There is no `lifecycleStatus`
///     and there must never be one — v1 had it, it drifted, and a provider who
///     unpublished their only listing stayed `active` with an empty profile.
///
/// The default service areas and the identity-document columns are Phase 7's
/// and Phase 10a's respectively; Phase 5 did not build ahead into them.
/// `providerType` was in that list and is now below — Phase 6a added it.
model ProviderProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id])
  businessName       String?            @map("business_name")

  /// §Phase 6a's required "How will you offer services?" choice. **Nullable,
  /// and the null is meaningful**: §1a's implicit path (Phase 8's first draft
  /// save, Phase 3's provider-variant registration) creates a profile without
  /// anybody having been asked, and §Phase 6a is the front door rather than
  /// the only door. Null therefore reads as *not yet asked*, which is what
  /// `providerOnboardingComplete` turns on — never as a default type, because
  /// guessing it would decide which documents §1e goes on to demand.
  providerType       ProviderType?      @map("provider_type")

  verificationTier   VerificationTier   @default(none) @map("verification_tier")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")

  /// The short introduction Phase 6a collects, capped at 160 characters there
  /// and in this module's Zod schema — the cap is a server-side rule
  /// (invariant 4), not a text-field attribute.
  bio               String? @db.VarChar(160)
  yearsOfExperience Int?    @map("years_of_experience")

  /// §1b, and never a global constant: the price this provider renews at,
  /// written once at their first confirmed payment. Null means "not yet set" —
  /// Phase 8a decides the value from §1b's cohort rule (the introductory rate
  /// for the first 100 providers, the standard rate after them), so nothing
  /// here defaults it and no provider-facing write may set it.
  subscriptionPriceLaari Int? @map("subscription_price_laari")

  /// Payment details (§Phase 5, load-bearing). The one piece of provider
  /// information that IS shown to a customer, and only at a booking's payment
  /// step, because the off-platform transfer cannot happen without it.
  /// Excluded structurally from every other response and from all logs —
  /// `toPublicProviderDto` has no branch that can reach these, and
  /// `paymentDetailsForBooking` is the only mapper that reads them.
  ///
  /// "and/or other transfer instructions": the three bank fields cover the
  /// normal case and `transferInstructions` carries anything that does not
  /// fit. Phase 6a requires the three at onboarding; nothing is required here,
  /// because a profile exists before onboarding finishes.
  bankName             String? @map("bank_name")
  bankAccountName      String? @map("bank_account_name")
  bankAccountNumber    String? @map("bank_account_number")
  transferInstructions String? @map("transfer_instructions")

  /// §Phase 5: one provider-level toggle gating all of their listings, and
  /// what Phase 8a's billing pause keys off (§1b Pause). Deliberately NOT on
  /// the Listing entity (§Phase 8).
  acceptingNewCustomers Boolean @default(true) @map("accepting_new_customers")

  /// §1g. An attribute of the *business*, evidenced by the registration
  /// document Gold already collects — never a nationality field on a person,
  /// and never a ranking boost. Nullable because "below Gold the attribute is
  /// absent rather than false": null is *not established*, which is a
  /// different claim from false. Set by Gold review (Phase 10a), never by the
  /// provider — `updateOwnProfile` cannot write it.
  maldivianOwned Boolean? @map("maldivian_owned")

  /// §1a: suspension is an INPUT to derived visibility, not a second filter
  /// reimplemented per query — `findVisibleProviders` reads it so one change
  /// covers search, Home and the public profile. Phase 10b owns the admin
  /// suspend/unsuspend action and its audit trail; Phase 5 owns the column and
  /// the filter, which is what the §Phase 5 Done-when asserts.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// §Phase 7: the islands this provider works on, account-level. A join row
  /// is soft-deleted rather than removed, so this relation is never the
  /// current list on its own — `ProviderServiceArea.removedAt` is.
  serviceAreas ProviderServiceArea[]

  /// The candidate scan in `findVisibleProviders` filters on these two before
  /// it asks the listing source anything.
  @@index([suspendedAt, id])
  @@index([verificationTier])
  @@map("provider_profile")
}

enum UserSessionRevokedReason {
  logout
  revoked_by_user
  refresh_expired
  refresh_reuse
  password_change
  // Phase 3b: a reset revokes every session, including the one that asked.
  password_reset
  email_change
  anonymised

  @@map("user_session_revoked_reason")
}

/// One per signed-in device. The credential is the RefreshToken rows below;
/// the access JWT carries this row's id as `sid` so revocation is immediate.
model UserSession {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  user          User                      @relation(fields: [userId], references: [id])
  deviceName    String                    @map("device_name")
  ipAddress     String                    @map("ip_address")
  userAgent     String                    @map("user_agent")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime                  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason UserSessionRevokedReason? @map("revoked_reason")

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("user_session")
}

/// One row per refresh token ever issued; the live one for a session has
/// rotated_at NULL. Keeping rotated rows is what lets a replayed old token be
/// told apart from garbage (spec §3).
model RefreshToken {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  session      UserSession @relation(fields: [sessionId], references: [id])
  tokenHash    String      @unique @map("token_hash")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(6)
  rotatedAt    DateTime?   @map("rotated_at") @db.Timestamptz(6)
  replacedById String?     @map("replaced_by_id") @db.Uuid

  @@index([sessionId, rotatedAt])
  @@map("refresh_token")
}

enum OtpPurpose {
  verify_email
  change_email
  // Phase 3b's forgot-password code. Same six digits, same limits, longer expiry.
  password_reset

  @@map("otp_purpose")
}

/// An emailed six-digit code. Never deleted: the two indexes are the two
/// send-limit counts (plan §Phase 3: 3/address/15 min AND 5/account/hour).
model EmailOtp {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  purpose        OtpPurpose
  targetEmail    String        @map("target_email")
  codeHash       String        @map("code_hash")
  attempts       Int           @default(0)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?     @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt  DateTime?     @map("invalidated_at") @db.Timestamptz(6)
  emailMessageId String?       @map("email_message_id") @db.Uuid
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose, createdAt])
  @@index([targetEmail, createdAt])
  @@map("email_otp")
}

// ---------------------------------------------------------------------------
// Phase 3c — push notification infrastructure
// ---------------------------------------------------------------------------

enum PushPlatform {
  android
  ios

  @@map("push_platform")
}

/// What the OS last told the app. `unknown` is the honest default and is not
/// the same as `denied`: a user who has never been asked has not refused.
/// Only `denied` triggers the immediate-email rung (plan §Phase 3c).
enum PushPermission {
  unknown
  granted
  denied

  @@map("push_permission")
}

enum DeviceTokenRevokedReason {
  signed_out
  /// The vendor reported the token no longer exists — app uninstalled or data cleared.
  unregistered
  /// The same raw token turned up registered to a different account (device handover).
  claimed_by_another_account
  account_anonymised

  @@map("device_token_revoked_reason")
}

/// One row per (user, app installation). A token *refresh* updates `token` in
/// place — the install is the identity, the token is a rotating credential, so
/// rotation is an update and not a new row. Revocation is soft, like everything
/// else. A partial unique index on `token WHERE revoked_at IS NULL` is added by
/// hand in the migration: one live registration per raw token, across all users.
model DeviceToken {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  user           User                      @relation(fields: [userId], references: [id])
  installationId String                    @map("installation_id")
  platform       PushPlatform
  token          String
  deviceName     String                    @map("device_name")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt     DateTime                  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason  DeviceTokenRevokedReason? @map("revoked_reason")

  deliveries PushDelivery[]

  @@unique([userId, installationId])
  @@index([userId, revokedAt])
  @@map("device_token")
}

/// The notification kinds this phase delivers. §Phase 3c specifies the
/// load-bearing provider-accept prompt and the emergency prompt; Phase 19 adds
/// its own kinds additively, and must not repurpose these.
enum NotificationKind {
  booking_accept_prompt
  emergency_dispatch

  @@map("notification_kind")
}

/// `emergency` is not a severity label — it selects the no-ladder path. An
/// emergency window is 30 minutes, which leaves no room to wait for a push to
/// go unconfirmed, so push and email go out together (plan §Phase 3c).
enum NotificationUrgency {
  standard
  emergency

  @@map("notification_urgency")
}

/// Why the email went. Every rung has its own value so the 5% alert can tell a
/// push-integration regression from users who turned notifications off.
enum EmailFallbackReason {
  /// The OS permission is known denied — email immediately, do not wait.
  permission_denied
  /// The user has no live device registration at all; push cannot arrive.
  no_registered_device
  /// Emergency: push and email in parallel, always.
  emergency_parallel
  /// Push went out, nothing confirmed it within the fallback window.
  unconfirmed_after_window

  @@map("email_fallback_reason")
}

/// One logical notification to one user — the unit the fallback chain reasons
/// about, and the unit Phase 10b looks up when asked "did this provider
/// actually get the emergency alert?". Never deleted.
model PushDispatch {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id])
  kind      NotificationKind
  urgency   NotificationUrgency
  /// The booking (or other subject) this is about. Deliberately not a foreign
  /// key: Phase 17 owns bookings and does not exist yet.
  subjectId String?             @map("subject_id") @db.Uuid

  /// What the copy is built from — booking type, customer first name, island —
  /// held because the 30-minute rung sends its email from a job, long after
  /// the caller has gone. Storing the rendered mail instead would freeze copy
  /// at dispatch time and put the same text in two places. No email address,
  /// no phone number and no amount is ever in here (root CLAUDE.md 1d); the
  /// recipient is reached through `userId`.
  context Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Set by the device that received the push. A vendor accepting a message is
  /// not delivery — only the app saying "it arrived" is.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// When the sweep job should send the fallback email. Null when the email
  /// already went out at dispatch time, or when it has already been sent.
  fallbackDueAt DateTime? @map("fallback_due_at") @db.Timestamptz(6)

  emailSentAt    DateTime?            @map("email_sent_at") @db.Timestamptz(6)
  emailReason    EmailFallbackReason? @map("email_reason")
  emailMessageId String?              @map("email_message_id") @db.Uuid
  emailMessage   EmailMessage?        @relation(fields: [emailMessageId], references: [id])

  deliveries PushDelivery[]

  @@index([fallbackDueAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("push_dispatch")
}

enum PushDeliveryStatus {
  /// The vendor accepted the message.
  sent
  /// The vendor refused it.
  failed
  /// Never attempted — the user has no live registration on that platform.
  skipped
  /// The app on that device reported the push arrived.
  confirmed

  @@map("push_delivery_status")
}

/// One row per device a dispatch was fanned out to. Multi-device means N of
/// these per dispatch; a single confirmation is enough to satisfy the dispatch.
model PushDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  dispatchId        String             @map("dispatch_id") @db.Uuid
  dispatch          PushDispatch       @relation(fields: [dispatchId], references: [id])
  deviceTokenId     String             @map("device_token_id") @db.Uuid
  deviceToken       DeviceToken        @relation(fields: [deviceTokenId], references: [id])
  status            PushDeliveryStatus
  /// The vendor's own id, when it gave one. Null for the file transport.
  providerMessageId String?            @map("provider_message_id")
  /// The error class name only — a vendor message can echo the token.
  failureReason     String?            @map("failure_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz(6)

  @@index([dispatchId])
  @@map("push_delivery")
}

// ---------------------------------------------------------------------------
// Phase 4 — categories
// ---------------------------------------------------------------------------

/// How a listing in this category is booked (plan §1c). The *mode* is a closed
/// set; the *catalogue* deliberately is not — see `Category`.
enum BookingMode {
  slot
  request

  @@map("booking_mode")
}

/// A service category. Twelve are seeded (plan §1d), but the catalogue is
/// **unlimited and never an enum** — §Phase 4's Done-when requires a
/// thirteenth added through the API to appear in Explore with no rebuild, so
/// `name` is free text and nothing in the schema or in validation enumerates
/// it. Only `bookingMode` above is closed, and that is the booking machine's
/// shape, not the catalogue's.
///
/// Every number here is seeded per category and stays admin-editable from
/// Phase 10b. Downstream modules read them and must never hardcode a value:
/// §1c's emergency gate reads `emergencyMinimumTier`, invariant 13's quote
/// clock reads `quoteExpiryMinutes` / `quoteApprovalMinutes`, and Round 28's
/// guarantee reads `callbackEligible`.
///
/// Invariant 8: no row is ever deleted. `DELETE /v1/admin/categories/:id`
/// clears `isActive`, which drops it from the public list and from Explore.
model Category {
  id             String  @id @default(uuid()) @db.Uuid
  /// Tile-short, and admin-editable — Round 25 renamed Computer to Appliance
  /// Repair, so a rename is a thing that really happens. Unique, and unique
  /// case-insensitively as well (a functional index, added in the migration):
  /// "plumbing" beside "Plumbing" would render as two tiles.
  ///
  /// The *identifier* everything else references is the UUID (Phase 8's
  /// listings, Phase 7's service areas), never this.
  name           String  @unique
  /// What the bootstrap keys on, so that renaming a seeded category does not
  /// make the next `db:seed` re-create it under its old name — two active
  /// rows, both in Explore. Written once with the seeded name and never
  /// updated; null on anything an admin created, which the seed never touches.
  seedKey        String? @unique @map("seed_key")
  /// Carries the scope the tile label has no room for — Round 25 seeds
  /// Appliance Repair's as "household appliances, TVs, computers, phones".
  description    String
  /// A glyph name the client resolves in its own registry, with a neutral
  /// fallback for one it does not know. Not an asset path and not an icon
  /// codepoint: a category seeded after a build shipped must still render.
  iconIdentifier String  @map("icon_identifier")
  /// A design-system accent token (`emerald`, `cyan` …), resolved by the
  /// client the same way and with the same fallback. Never a hex value.
  colorToken     String  @map("color_token")
  sortOrder      Int     @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  /// The default a listing in this category takes; overridable per listing (§1c).
  bookingMode BookingMode @map("booking_mode")

  /// §1c: true for Plumbing, Electrical, AC Repair and Moving alone. One half
  /// of the composed emergency rule — the other halves are the provider's
  /// tier and the listing's `isEmergency`.
  emergencyCapable             Boolean           @default(false) @map("emergency_capable")
  /// How soon a booking may be scheduled from now (Round 14).
  minimumLeadTimeMinutes       Int               @map("minimum_lead_time_minutes")
  /// How long a provider may take to *answer* an emergency broadcast — 30 for
  /// all four capable categories (Round 22). Never how long they take to
  /// arrive: that is per-offer `etaMinutes` on `EmergencyOffer` (§1c).
  emergencyAcceptWindowMinutes Int?              @map("emergency_accept_window_minutes")
  /// The tier bar for emergency work in this category (Round 15) — `gold` for
  /// Electrical and Plumbing, `silver` for AC Repair and Moving. Read it;
  /// never hardcode `silver`.
  emergencyMinimumTier         VerificationTier? @map("emergency_minimum_tier")
  /// The arrival options a provider picks from when making an offer (Round 22).
  /// A Prisma scalar list cannot be null, so the plan's "null elsewhere" is an
  /// empty array here; nothing is preselected in the UI either way.
  emergencyEtaPresetsMinutes   Int[]             @map("emergency_eta_presets_minutes")

  /// Invariant 13, per category (Round 15) — 120/240 on the household trades,
  /// 1440/4320 where planning happens, null on the slot categories, which do
  /// not quote. Never hardcode 24h/72h.
  quoteExpiryMinutes   Int? @map("quote_expiry_minutes")
  quoteApprovalMinutes Int? @map("quote_approval_minutes")

  /// Round 28. Gates the wizard's step-6 opt-in, the card badge and the claim
  /// path. False where nothing was fixed and so nothing can un-fix.
  callbackEligible Boolean  @default(false) @map("callback_eligible")
  /// The request form's occasion chips (Round 25), always ending in "Other".
  /// Photography and Boat Charter only; empty elsewhere, for the same
  /// scalar-list reason as `emergencyEtaPresetsMinutes`.
  occasionPresets  String[] @map("occasion_presets")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("category")
}

// ---------------------------------------------------------------------------
// Phase 7 — service areas & location
// ---------------------------------------------------------------------------

/// One inhabited island of the Maldives (§Phase 7, §0.0 item 12).
///
/// **A name is not an identifier and never was.** Sixteen normalised names
/// occur in more than one atoll and `Meedhoo` exists in three, so this carries
/// a UUID like every other entity (invariant 8) and nothing — a service area,
/// a booking location, a search filter — may store or match on the name.
///
/// Seeded from `docs/data/inhabited-islands.json`, the ministry register
/// extract, by `npm run db:seed`. Every derived column below is recomputed on
/// each seed run; the register is the source and none of them is anybody's to
/// edit.
model Island {
  id String @id @default(uuid()) @db.Uuid

  /// What the bootstrap keys on: `"<atollAbbr>:<name>"`, unique across the
  /// register. Not the name, for the same reason `Category.seedKey` is not the
  /// name — a row renamed underneath the seed would otherwise be re-created.
  seedKey String @unique @map("seed_key")

  /// The register spelling, apostrophes preserved. `An'golhitheemu`,
  /// `Kon'dey`, `Male'` — the apostrophe transliterates a Thaana glottal and
  /// stripping it produces a different, wrong name. Rendering is
  /// `displayName`'s job, not this column's.
  name String

  /// The administrative atoll, as the register writes it — `Haa Dhaalu`.
  atollName String @map("atoll_name")

  /// The standard atoll code — `HDh`, `Dh`, `GA`. This is what qualifies an
  /// ambiguous name in the Maldivian convention (`Dh. Meedhoo`) and what
  /// island search also matches against (`gdh` alone lists that atoll).
  atollAbbr String @map("atoll_abbr")

  /// **Computed at seed time, never hardcoded** (§0.0 item 12). True when
  /// another island shares this island's case-folded, apostrophe-stripped
  /// name. Grouping on the *normalised* form is the point: on the raw strings
  /// there are 15 collisions, on the normalised form 16 — `K. Vilingili` and
  /// `GA. Vilin'gili` are different names that search cannot tell apart, and
  /// an exact-match grouping leaves that one pair broken.
  nameAmbiguous Boolean @map("name_ambiguous")

  /// The normalised bare name — accents folded, apostrophes and punctuation
  /// dropped, lower-cased. Search matches *anywhere* in this.
  searchName String @map("search_name")

  /// The normalised atoll code followed by the normalised name —
  /// `dhmeedhoo`. One column covers both halves of the search rule: a
  /// substring of the bare name is also a substring of this, and matching it
  /// is what makes `dh mee` find `Dh. Meedhoo` and `gdh` list that atoll.
  searchQualified String @map("search_qualified")

  /// Invariant 8's soft delete. The register loses islands (depopulation,
  /// consolidation) and a row that has ever been a service area or a booking
  /// location can never be removed. Phase 10b owns the admin action.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceAreas ProviderServiceArea[]

  /// The natural key, so two rows cannot claim the same island of the same atoll.
  @@unique([atollAbbr, name])
  @@index([isActive, name])
  @@index([searchQualified])
  @@map("island")
}

/// The islands a provider works on (§Phase 7).
///
/// Account-level and provider-scoped. Phase 8 gives a *listing* its own
/// service areas, which is what discovery reads; this is the provider's own
/// coverage, and §Phase 6a pre-fills the wizard from it.
model ProviderServiceArea {
  id String @id @default(uuid()) @db.Uuid

  providerProfileId String          @map("provider_profile_id") @db.Uuid
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  islandId String @map("island_id") @db.Uuid
  island   Island @relation(fields: [islandId], references: [id])

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  /// Invariant 8: removing an island from the list clears nothing and deletes
  /// no row — it stamps this, and re-adding the island revives the same row
  /// with a fresh `addedAt`. The unique pair below is what makes that work.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerProfileId, islandId])
  @@index([islandId, removedAt])
  @@map("provider_service_area")
}
