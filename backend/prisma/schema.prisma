// RaajjePro database schema.
//
// Conventions every model follows (plan §2 Architecture Decisions):
//   - UUID primary key:      id String @id @default(uuid()) @db.Uuid
//   - integer laari money:   ...Laari Int   — MVR × 100, never Float or Decimal
//   - soft delete:           a status/visibility field; no row is ever DELETEd
//   - snake_case in the DB:  @@map / @map, camelCase in code
// Phase 2 encodes these as reusable base patterns. Phase 2 adds the
// infrastructure tables below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per scheduled job, holding when it last fired. The Phase 0 no-op
/// job upserts its row every minute, which is how "the runner is running" is
/// observed — by a query, not by reading a log. Upserting keeps the table at
/// one row per job with nothing to prune, so the no-delete rule holds here too.
model JobHeartbeat {
  id      String   @id @default(uuid()) @db.Uuid
  jobName String   @unique @map("job_name")
  firedAt DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)

  @@map("job_heartbeat")
}

// ---------------------------------------------------------------------------
// Phase 2 — core infrastructure
// ---------------------------------------------------------------------------

/// Rate-limit window counters. UNLOGGED (set in the migration): out of the WAL
/// and PITR stream, which is right for ephemeral state — and means an unclean
/// shutdown truncates the table and every limit fails open for one window.
/// Rows are keyed per (scope, subject) and reused across windows, never deleted.
model RateLimitCounter {
  key             String   @id
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)

  @@map("rate_limit_counter")
}

enum IdempotencyStatus {
  in_progress
  completed
  abandoned

  @@map("idempotency_status")
}

/// One row per (subject, operation, client key). A repeat with the same body
/// replays response_status/response_body; nothing here is ever deleted.
model IdempotencyRecord {
  id              String            @id @default(uuid()) @db.Uuid
  subject         String
  operation       String
  clientKey       String            @map("client_key")
  requestHash     String            @map("request_hash")
  status          IdempotencyStatus
  responseStatus  Int?              @map("response_status")
  responseHeaders Json?             @map("response_headers")
  responseBody    Json?             @map("response_body")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)

  @@unique([subject, operation, clientKey])
  @@map("idempotency_record")
}

enum AdminStatus {
  active
  disabled

  @@map("admin_status")
}

/// Admin identity (plan §Phase 2). One role in v1. `status` is the soft-delete
/// field. The TOTP secret is AES-256-GCM ciphertext; null until enrolment starts.
model AdminUser {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique
  passwordHash        String      @map("password_hash")
  role                String      @default("admin")
  status              AdminStatus @default(active)
  totpSecretEncrypted String?     @map("totp_secret_encrypted")
  totpEnrolledAt      DateTime?   @map("totp_enrolled_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      AdminSession[]
  recoveryCodes AdminRecoveryCode[]

  @@map("admin_user")
}

enum SessionRevokedReason {
  logout
  force_logout
  idle_timeout
  absolute_expiry
  mfa_failures
  password_change

  @@map("session_revoked_reason")
}

/// A browser session. The cookie holds a random token; only its sha256 is here.
model AdminSession {
  id                String                @id @default(uuid()) @db.Uuid
  adminId           String                @map("admin_id") @db.Uuid
  admin             AdminUser             @relation(fields: [adminId], references: [id])
  tokenHash         String                @unique @map("token_hash")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime              @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(6)
  mfaVerifiedAt     DateTime?             @map("mfa_verified_at") @db.Timestamptz(6)
  reauthenticatedAt DateTime?             @map("reauthenticated_at") @db.Timestamptz(6)
  mfaFailures       Int                   @default(0) @map("mfa_failures")
  ipAddress         String                @map("ip_address")
  userAgent         String                @map("user_agent")
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     SessionRevokedReason? @map("revoked_reason")

  @@index([adminId, revokedAt])
  @@map("admin_session")
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  admin     AdminUser @relation(fields: [adminId], references: [id])
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([adminId, codeHash])
  @@map("admin_recovery_code")
}

enum AuditActorType {
  admin
  user
  system

  @@map("audit_actor_type")
}

/// Append-only. Every admin action: who, when, what, on what, why (plan
/// §Phase 2). `metadata` holds IDs and enums only — never an email, phone or
/// document. No code path updates or deletes a row.
model AuditLogEntry {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String         @map("target_id")
  reason     String
  metadata   Json?
  requestId  String?        @map("request_id")
  ipAddress  String?        @map("ip_address")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log_entry")
}

enum EmailChannel {
  otp
  notification
  marketing

  @@map("email_channel")
}

enum EmailMessageStatus {
  queued
  sent
  failed
  suppressed
  delivered
  bounced
  complained
  rejected
  delivery_delayed

  @@map("email_message_status")
}

/// Per-message delivery log — SES has no searchable console, so this is what
/// answers "did this user actually receive it?" (plan §Phase 3c, §Phase 10b).
model EmailMessage {
  id                String             @id @default(uuid()) @db.Uuid
  channel           EmailChannel
  toAddress         String             @map("to_address")
  recipientUserId   String?            @map("recipient_user_id") @db.Uuid
  subject           String
  status            EmailMessageStatus
  configurationSet  String?            @map("configuration_set")
  providerMessageId String?            @unique @map("provider_message_id")
  failureReason     String?            @map("failure_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  lastEventAt       DateTime?          @map("last_event_at") @db.Timestamptz(6)

  events         EmailEvent[]
  otps           EmailOtp[]
  pushDispatches PushDispatch[]

  @@index([toAddress, createdAt])
  @@index([recipientUserId, createdAt])
  @@map("email_message")
}

/// One row per SNS notification received from the SES event destination.
/// `snsMessageId` is unique because SNS retries.
model EmailEvent {
  id                String        @id @default(uuid()) @db.Uuid
  snsMessageId      String        @unique @map("sns_message_id")
  messageId         String?       @map("message_id") @db.Uuid
  message           EmailMessage? @relation(fields: [messageId], references: [id])
  providerMessageId String?       @map("provider_message_id")
  eventType         String        @map("event_type")
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(6)
  payload           Json
  receivedAt        DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([providerMessageId])
  @@map("email_event")
}

enum SuppressionReason {
  hard_bounce
  complaint
  manual

  @@map("suppression_reason")
}

/// Addresses we must not send to. Active while lifted_at IS NULL — a partial
/// unique index on that condition is added by hand in the migration. Lifting
/// (Phase 10b) sets lifted_at; nothing is deleted.
model EmailSuppression {
  id              String            @id @default(uuid()) @db.Uuid
  address         String
  reason          SuppressionReason
  sourceEventId   String?           @map("source_event_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  liftedAt        DateTime?         @map("lifted_at") @db.Timestamptz(6)
  liftedByAdminId String?           @map("lifted_by_admin_id") @db.Uuid
  liftReason      String?           @map("lift_reason")

  @@index([address])
  @@map("email_suppression")
}

// ---------------------------------------------------------------------------
// Phase 3 — identity & authentication
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  frozen
  anonymised

  @@map("user_status")
}

/// A customer or provider account (plan §Phase 3). `status` is the soft-delete
/// field: `frozen` after a deletion request, `anonymised` when the job has
/// replaced name, email and phone. `phoneE164` is deliberately NOT unique —
/// exclusivity begins at Bronze (§0.0 item 8a) and is enforced in the service.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash        String     @map("password_hash")
  fullName            String     @map("full_name")
  phoneE164           String?    @map("phone_e164")
  phoneDialCode       String?    @map("phone_dial_code")
  status              UserStatus @default(active)
  termsAcceptedAt     DateTime   @map("terms_accepted_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  deletionDeadlineAt  DateTime?  @map("deletion_deadline_at") @db.Timestamptz(6)
  anonymisedAt        DateTime?  @map("anonymised_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Phase 3c. The OS-level answer, reported by the app. Account-level rather
  /// than per-device: the fallback question is "can a push reach this person
  /// at all", and one device saying no while another says yes is answered by
  /// the live device registrations, not by this field.
  pushPermission          PushPermission @default(unknown) @map("push_permission")
  pushPermissionUpdatedAt DateTime?      @map("push_permission_updated_at") @db.Timestamptz(6)

  providerProfile ProviderProfile?
  sessions        UserSession[]
  otps            EmailOtp[]
  deviceTokens    DeviceToken[]
  pushDispatches  PushDispatch[]

  /// §Phase 8a. Every manual payment this account has claimed to make — a
  /// provider's subscription transfers today, and §1c's emergency dispatch
  /// fee, which a *customer* pays, when §Phase 17.3 lands. On the user rather
  /// than the provider profile for exactly that reason.
  paymentSubmissions PaymentSubmission[]

  @@index([phoneE164])
  @@index([status, deletionDeadlineAt])
  @@map("app_user")
}

enum VerificationTier {
  none
  bronze
  silver
  gold

  @@map("verification_tier")
}

enum VerificationStatus {
  unverified
  pending
  verified

  @@map("verification_status")
}

/// §Phase 6a, Round 21. How a provider offers services — and **not
/// cosmetic**: §1e reads it to decide what Gold verification asks for (an
/// individual supplies personal ID, a business supplies registration
/// documents), and §1g's Maldivian-owned *business* attribute hangs from it.
enum ProviderType {
  individual
  business

  @@map("provider_type")
}

/// The provider half of an account. Phase 3 created it with only the columns
/// Phase 3 reads — Business/Trade Name from the Register provider variant,
/// and the tier the Bronze-uniqueness rule checks. Phase 5 adds the rest
/// additively (plan §Phase 5). `verificationTier` is what the badge renders;
/// `verificationStatus` is only the review state of a pending submission.
///
/// Two things are deliberately **not** columns here:
///
///   - **A phone number.** §Phase 5 stores "exactly one phone number" and that
///     is `User.phoneE164`, captured in Phase 3. A second copy on this row
///     would be a second thing to protect, and §1c allows exactly one endpoint
///     in the whole system to return a number to another user.
///   - **A public visibility flag.** §1a: visibility is *derived* from the
///     published-listing count, never stored. There is no `lifecycleStatus`
///     and there must never be one — v1 had it, it drifted, and a provider who
///     unpublished their only listing stayed `active` with an empty profile.
///
/// The default service areas and the identity-document columns are Phase 7's
/// and Phase 10a's respectively; Phase 5 did not build ahead into them.
/// `providerType` was in that list and is now below — Phase 6a added it.
model ProviderProfile {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  user         User    @relation(fields: [userId], references: [id])
  businessName String? @map("business_name")

  /// §Phase 6a's required "How will you offer services?" choice. **Nullable,
  /// and the null is meaningful**: §1a's implicit path (Phase 8's first draft
  /// save, Phase 3's provider-variant registration) creates a profile without
  /// anybody having been asked, and §Phase 6a is the front door rather than
  /// the only door. Null therefore reads as *not yet asked*, which is what
  /// `providerOnboardingComplete` turns on — never as a default type, because
  /// guessing it would decide which documents §1e goes on to demand.
  providerType ProviderType? @map("provider_type")

  /// When this account first satisfied §Phase 6a's onboarding requirements.
  /// **A record of an event, not a copy of the fields** — which is the whole
  /// point. §Phase 6a's Done-when asks a past-tense question, "a provider who
  /// already completed onboarding never sees it again", and a predicate over
  /// current field values cannot answer it: five of those values are legally
  /// editable, so a provider trading for months who cleared a bank field read
  /// *incomplete* and was routed back into onboarding, whose last step hands
  /// off to a fresh wizard draft (ledger P6A-3, owner's decision 2026-09-10).
  /// Written once and never cleared, like `trialStartedAt` and
  /// `paymentClaimedAt` elsewhere in this schema.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  verificationTier   VerificationTier   @default(none) @map("verification_tier")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")

  /// The short introduction Phase 6a collects, capped at 160 characters there
  /// and in this module's Zod schema — the cap is a server-side rule
  /// (invariant 4), not a text-field attribute.
  bio               String? @db.VarChar(160)
  yearsOfExperience Int?    @map("years_of_experience")

  /// §1b, and never a global constant: the price this provider renews at,
  /// written once at their first confirmed payment. Null means "not yet set" —
  /// Phase 8a decides the value from §1b's cohort rule (the introductory rate
  /// for the first 100 providers, the standard rate after them), so nothing
  /// here defaults it and no provider-facing write may set it.
  subscriptionPriceLaari Int? @map("subscription_price_laari")

  /// Payment details (§Phase 5, load-bearing). The one piece of provider
  /// information that IS shown to a customer, and only at a booking's payment
  /// step, because the off-platform transfer cannot happen without it.
  /// Excluded structurally from every other response and from all logs —
  /// `toPublicProviderDto` has no branch that can reach these, and
  /// `paymentDetailsForBooking` is the only mapper that reads them.
  ///
  /// "and/or other transfer instructions": the three bank fields cover the
  /// normal case and `transferInstructions` carries anything that does not
  /// fit. Phase 6a requires the three at onboarding; nothing is required here,
  /// because a profile exists before onboarding finishes.
  bankName             String? @map("bank_name")
  bankAccountName      String? @map("bank_account_name")
  bankAccountNumber    String? @map("bank_account_number")
  transferInstructions String? @map("transfer_instructions")

  /// §Phase 5: one provider-level toggle gating all of their listings, and
  /// what Phase 8a's billing pause keys off (§1b Pause). Deliberately NOT on
  /// the Listing entity (§Phase 8).
  acceptingNewCustomers Boolean @default(true) @map("accepting_new_customers")

  /// §1g. An attribute of the *business*, evidenced by the registration
  /// document Gold already collects — never a nationality field on a person,
  /// and never a ranking boost. Nullable because "below Gold the attribute is
  /// absent rather than false": null is *not established*, which is a
  /// different claim from false. Set by Gold review (Phase 10a), never by the
  /// provider — `updateOwnProfile` cannot write it.
  maldivianOwned Boolean? @map("maldivian_owned")

  /// §1a: suspension is an INPUT to derived visibility, not a second filter
  /// reimplemented per query — `findVisibleProviders` reads it so one change
  /// covers search, Home and the public profile. Phase 10b owns the admin
  /// suspend/unsuspend action and its audit trail; Phase 5 owns the column and
  /// the filter, which is what the §Phase 5 Done-when asserts.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// §Phase 7: the islands this provider works on, account-level. A join row
  /// is soft-deleted rather than removed, so this relation is never the
  /// current list on its own — `ProviderServiceArea.removedAt` is.
  serviceAreas ProviderServiceArea[]

  /// §Phase 8. Every listing this provider owns, drafts and deleted rows
  /// included — the relation is not a filtered view and no consumer should
  /// treat it as one. §1a's published-listing count goes through
  /// `PublishedListings`, which is one indexed query rather than a load.
  listings Listing[]

  /// §Phase 8a. At most one, and **absent means the free tier** rather than
  /// unknown — nothing creates a row on signup, so a provider who has never
  /// trialled or paid has none and `getProviderEntitlements` answers free.
  subscription ProviderSubscription?

  /// §1b step 6's PDF invoices, one per confirmed payment.
  invoices Invoice[]

  /// The candidate scan in `findVisibleProviders` filters on these two before
  /// it asks the listing source anything.
  @@index([suspendedAt, id])
  @@index([verificationTier])
  @@map("provider_profile")
}

enum UserSessionRevokedReason {
  logout
  revoked_by_user
  refresh_expired
  refresh_reuse
  password_change
  // Phase 3b: a reset revokes every session, including the one that asked.
  password_reset
  email_change
  anonymised

  @@map("user_session_revoked_reason")
}

/// One per signed-in device. The credential is the RefreshToken rows below;
/// the access JWT carries this row's id as `sid` so revocation is immediate.
model UserSession {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  user          User                      @relation(fields: [userId], references: [id])
  deviceName    String                    @map("device_name")
  ipAddress     String                    @map("ip_address")
  userAgent     String                    @map("user_agent")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime                  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason UserSessionRevokedReason? @map("revoked_reason")

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("user_session")
}

/// One row per refresh token ever issued; the live one for a session has
/// rotated_at NULL. Keeping rotated rows is what lets a replayed old token be
/// told apart from garbage (spec §3).
model RefreshToken {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  session      UserSession @relation(fields: [sessionId], references: [id])
  tokenHash    String      @unique @map("token_hash")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(6)
  rotatedAt    DateTime?   @map("rotated_at") @db.Timestamptz(6)
  replacedById String?     @map("replaced_by_id") @db.Uuid

  @@index([sessionId, rotatedAt])
  @@map("refresh_token")
}

enum OtpPurpose {
  verify_email
  change_email
  // Phase 3b's forgot-password code. Same six digits, same limits, longer expiry.
  password_reset

  @@map("otp_purpose")
}

/// An emailed six-digit code. Never deleted: the two indexes are the two
/// send-limit counts (plan §Phase 3: 3/address/15 min AND 5/account/hour).
model EmailOtp {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  purpose        OtpPurpose
  targetEmail    String        @map("target_email")
  codeHash       String        @map("code_hash")
  attempts       Int           @default(0)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?     @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt  DateTime?     @map("invalidated_at") @db.Timestamptz(6)
  emailMessageId String?       @map("email_message_id") @db.Uuid
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose, createdAt])
  @@index([targetEmail, createdAt])
  @@map("email_otp")
}

// ---------------------------------------------------------------------------
// Phase 3c — push notification infrastructure
// ---------------------------------------------------------------------------

enum PushPlatform {
  android
  ios

  @@map("push_platform")
}

/// What the OS last told the app. `unknown` is the honest default and is not
/// the same as `denied`: a user who has never been asked has not refused.
/// Only `denied` triggers the immediate-email rung (plan §Phase 3c).
enum PushPermission {
  unknown
  granted
  denied

  @@map("push_permission")
}

enum DeviceTokenRevokedReason {
  signed_out
  /// The vendor reported the token no longer exists — app uninstalled or data cleared.
  unregistered
  /// The same raw token turned up registered to a different account (device handover).
  claimed_by_another_account
  account_anonymised

  @@map("device_token_revoked_reason")
}

/// One row per (user, app installation). A token *refresh* updates `token` in
/// place — the install is the identity, the token is a rotating credential, so
/// rotation is an update and not a new row. Revocation is soft, like everything
/// else. A partial unique index on `token WHERE revoked_at IS NULL` is added by
/// hand in the migration: one live registration per raw token, across all users.
model DeviceToken {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  user           User                      @relation(fields: [userId], references: [id])
  installationId String                    @map("installation_id")
  platform       PushPlatform
  token          String
  deviceName     String                    @map("device_name")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt     DateTime                  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason  DeviceTokenRevokedReason? @map("revoked_reason")

  deliveries PushDelivery[]

  @@unique([userId, installationId])
  @@index([userId, revokedAt])
  @@map("device_token")
}

/// The notification kinds this phase delivers. §Phase 3c specifies the
/// load-bearing provider-accept prompt and the emergency prompt; Phase 19 adds
/// its own kinds additively, and must not repurpose these.
enum NotificationKind {
  booking_accept_prompt
  emergency_dispatch

  @@map("notification_kind")
}

/// `emergency` is not a severity label — it selects the no-ladder path. An
/// emergency window is 30 minutes, which leaves no room to wait for a push to
/// go unconfirmed, so push and email go out together (plan §Phase 3c).
enum NotificationUrgency {
  standard
  emergency

  @@map("notification_urgency")
}

/// Why the email went. Every rung has its own value so the 5% alert can tell a
/// push-integration regression from users who turned notifications off.
enum EmailFallbackReason {
  /// The OS permission is known denied — email immediately, do not wait.
  permission_denied
  /// The user has no live device registration at all; push cannot arrive.
  no_registered_device
  /// Emergency: push and email in parallel, always.
  emergency_parallel
  /// Push went out, nothing confirmed it within the fallback window.
  unconfirmed_after_window

  @@map("email_fallback_reason")
}

/// One logical notification to one user — the unit the fallback chain reasons
/// about, and the unit Phase 10b looks up when asked "did this provider
/// actually get the emergency alert?". Never deleted.
model PushDispatch {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id])
  kind      NotificationKind
  urgency   NotificationUrgency
  /// The booking (or other subject) this is about. Deliberately not a foreign
  /// key: Phase 17 owns bookings and does not exist yet.
  subjectId String?             @map("subject_id") @db.Uuid

  /// What the copy is built from — booking type, customer first name, island —
  /// held because the 30-minute rung sends its email from a job, long after
  /// the caller has gone. Storing the rendered mail instead would freeze copy
  /// at dispatch time and put the same text in two places. No email address,
  /// no phone number and no amount is ever in here (root CLAUDE.md 1d); the
  /// recipient is reached through `userId`.
  context Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Set by the device that received the push. A vendor accepting a message is
  /// not delivery — only the app saying "it arrived" is.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// When the sweep job should send the fallback email. Null when the email
  /// already went out at dispatch time, or when it has already been sent.
  fallbackDueAt DateTime? @map("fallback_due_at") @db.Timestamptz(6)

  emailSentAt    DateTime?            @map("email_sent_at") @db.Timestamptz(6)
  emailReason    EmailFallbackReason? @map("email_reason")
  emailMessageId String?              @map("email_message_id") @db.Uuid
  emailMessage   EmailMessage?        @relation(fields: [emailMessageId], references: [id])

  deliveries PushDelivery[]

  @@index([fallbackDueAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("push_dispatch")
}

enum PushDeliveryStatus {
  /// The vendor accepted the message.
  sent
  /// The vendor refused it.
  failed
  /// Never attempted — the user has no live registration on that platform.
  skipped
  /// The app on that device reported the push arrived.
  confirmed

  @@map("push_delivery_status")
}

/// One row per device a dispatch was fanned out to. Multi-device means N of
/// these per dispatch; a single confirmation is enough to satisfy the dispatch.
model PushDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  dispatchId        String             @map("dispatch_id") @db.Uuid
  dispatch          PushDispatch       @relation(fields: [dispatchId], references: [id])
  deviceTokenId     String             @map("device_token_id") @db.Uuid
  deviceToken       DeviceToken        @relation(fields: [deviceTokenId], references: [id])
  status            PushDeliveryStatus
  /// The vendor's own id, when it gave one. Null for the file transport.
  providerMessageId String?            @map("provider_message_id")
  /// The error class name only — a vendor message can echo the token.
  failureReason     String?            @map("failure_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz(6)

  @@index([dispatchId])
  @@map("push_delivery")
}

// ---------------------------------------------------------------------------
// Phase 4 — categories
// ---------------------------------------------------------------------------

/// How a listing in this category is booked (plan §1c). The *mode* is a closed
/// set; the *catalogue* deliberately is not — see `Category`.
enum BookingMode {
  slot
  request

  @@map("booking_mode")
}

/// A service category. Twelve are seeded (plan §1d), but the catalogue is
/// **unlimited and never an enum** — §Phase 4's Done-when requires a
/// thirteenth added through the API to appear in Explore with no rebuild, so
/// `name` is free text and nothing in the schema or in validation enumerates
/// it. Only `bookingMode` above is closed, and that is the booking machine's
/// shape, not the catalogue's.
///
/// Every number here is seeded per category and stays admin-editable from
/// Phase 10b. Downstream modules read them and must never hardcode a value:
/// §1c's emergency gate reads `emergencyMinimumTier`, invariant 13's quote
/// clock reads `quoteExpiryMinutes` / `quoteApprovalMinutes`, and Round 28's
/// guarantee reads `callbackEligible`.
///
/// Invariant 8: no row is ever deleted. `DELETE /v1/admin/categories/:id`
/// clears `isActive`, which drops it from the public list and from Explore.
model Category {
  id             String  @id @default(uuid()) @db.Uuid
  /// Tile-short, and admin-editable — Round 25 renamed Computer to Appliance
  /// Repair, so a rename is a thing that really happens. Unique, and unique
  /// case-insensitively as well (a functional index, added in the migration):
  /// "plumbing" beside "Plumbing" would render as two tiles.
  ///
  /// The *identifier* everything else references is the UUID (Phase 8's
  /// listings, Phase 7's service areas), never this.
  name           String  @unique
  /// What the bootstrap keys on, so that renaming a seeded category does not
  /// make the next `db:seed` re-create it under its old name — two active
  /// rows, both in Explore. Written once with the seeded name and never
  /// updated; null on anything an admin created, which the seed never touches.
  seedKey        String? @unique @map("seed_key")
  /// Carries the scope the tile label has no room for — Round 25 seeds
  /// Appliance Repair's as "household appliances, TVs, computers, phones".
  description    String
  /// A glyph name the client resolves in its own registry, with a neutral
  /// fallback for one it does not know. Not an asset path and not an icon
  /// codepoint: a category seeded after a build shipped must still render.
  iconIdentifier String  @map("icon_identifier")
  /// A design-system accent token (`emerald`, `cyan` …), resolved by the
  /// client the same way and with the same fallback. Never a hex value.
  colorToken     String  @map("color_token")
  sortOrder      Int     @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  /// The default a listing in this category takes; overridable per listing (§1c).
  bookingMode BookingMode @map("booking_mode")

  /// §1c: true for Plumbing, Electrical, AC Repair and Moving alone. One half
  /// of the composed emergency rule — the other halves are the provider's
  /// tier and the listing's `isEmergency`.
  emergencyCapable             Boolean           @default(false) @map("emergency_capable")
  /// How soon a booking may be scheduled from now (Round 14).
  minimumLeadTimeMinutes       Int               @map("minimum_lead_time_minutes")
  /// How long a provider may take to *answer* an emergency broadcast — 30 for
  /// all four capable categories (Round 22). Never how long they take to
  /// arrive: that is per-offer `etaMinutes` on `EmergencyOffer` (§1c).
  emergencyAcceptWindowMinutes Int?              @map("emergency_accept_window_minutes")
  /// The tier bar for emergency work in this category (Round 15) — `gold` for
  /// Electrical and Plumbing, `silver` for AC Repair and Moving. Read it;
  /// never hardcode `silver`.
  emergencyMinimumTier         VerificationTier? @map("emergency_minimum_tier")
  /// The arrival options a provider picks from when making an offer (Round 22).
  /// A Prisma scalar list cannot be null, so the plan's "null elsewhere" is an
  /// empty array here; nothing is preselected in the UI either way.
  emergencyEtaPresetsMinutes   Int[]             @map("emergency_eta_presets_minutes")

  /// Invariant 13, per category (Round 15) — 120/240 on the household trades,
  /// 1440/4320 where planning happens, null on the slot categories, which do
  /// not quote. Never hardcode 24h/72h.
  quoteExpiryMinutes   Int? @map("quote_expiry_minutes")
  quoteApprovalMinutes Int? @map("quote_approval_minutes")

  /// Round 28. Gates the wizard's step-6 opt-in, the card badge and the claim
  /// path. False where nothing was fixed and so nothing can un-fix.
  callbackEligible Boolean  @default(false) @map("callback_eligible")
  /// The request form's occasion chips (Round 25), always ending in "Other".
  /// Photography and Boat Charter only; empty elsewhere, for the same
  /// scalar-list reason as `emergencyEtaPresetsMinutes`.
  occasionPresets  String[] @map("occasion_presets")

  /// §Phase 9's step-1 chips, and 🔧 **this phase's column — added
  /// 2026-09-10.** §Phase 9 requires "a category-scoped set of suggested
  /// tags" as tappable pills and is frontend-only, so it cannot add the
  /// column and would stop mid-build on the missing one.
  ///
  /// **Designed, not invented**: seeded from `Create Service.dc.html`'s
  /// `TAGS` map, which covers all twelve categories. Note the contrast with
  /// the price units, which deliberately have no column — the same prototype
  /// keys *these* by category and renders the units as a flat five, so the
  /// designer keyed the thing the plan calls category-scoped and left the
  /// other alone.
  ///
  /// Suggestions only. A listing's own `tags` are free text underneath the
  /// chips and nothing validates them against this list.
  suggestedTags String[] @map("suggested_tags")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// §Phase 8. Read by the emergency re-evaluation and by Phase 15's browse;
  /// never loaded whole.
  listings Listing[]

  @@index([isActive, sortOrder])
  @@map("category")
}

// ---------------------------------------------------------------------------
// Phase 7 — service areas & location
// ---------------------------------------------------------------------------

/// One inhabited island of the Maldives (§Phase 7, §0.0 item 12).
///
/// **A name is not an identifier and never was.** Sixteen normalised names
/// occur in more than one atoll and `Meedhoo` exists in three, so this carries
/// a UUID like every other entity (invariant 8) and nothing — a service area,
/// a booking location, a search filter — may store or match on the name.
///
/// Seeded from `docs/data/inhabited-islands.json`, the ministry register
/// extract, by `npm run db:seed`. Every derived column below is recomputed on
/// each seed run; the register is the source and none of them is anybody's to
/// edit.
model Island {
  id String @id @default(uuid()) @db.Uuid

  /// What the bootstrap keys on: `"<atollAbbr>:<name>"`, unique across the
  /// register. Not the name, for the same reason `Category.seedKey` is not the
  /// name — a row renamed underneath the seed would otherwise be re-created.
  seedKey String @unique @map("seed_key")

  /// The register spelling, apostrophes preserved. `An'golhitheemu`,
  /// `Kon'dey`, `Male'` — the apostrophe transliterates a Thaana glottal and
  /// stripping it produces a different, wrong name. Rendering is
  /// `displayName`'s job, not this column's.
  name String

  /// The administrative atoll, as the register writes it — `Haa Dhaalu`.
  atollName String @map("atoll_name")

  /// The standard atoll code — `HDh`, `Dh`, `GA`. This is what qualifies an
  /// ambiguous name in the Maldivian convention (`Dh. Meedhoo`) and what
  /// island search also matches against (`gdh` alone lists that atoll).
  atollAbbr String @map("atoll_abbr")

  /// **Computed at seed time, never hardcoded** (§0.0 item 12). True when
  /// another island shares this island's case-folded, apostrophe-stripped
  /// name. Grouping on the *normalised* form is the point: on the raw strings
  /// there are 15 collisions, on the normalised form 16 — `K. Vilingili` and
  /// `GA. Vilin'gili` are different names that search cannot tell apart, and
  /// an exact-match grouping leaves that one pair broken.
  nameAmbiguous Boolean @map("name_ambiguous")

  /// The normalised bare name — accents folded, apostrophes and punctuation
  /// dropped, lower-cased. Search matches *anywhere* in this.
  searchName String @map("search_name")

  /// The normalised atoll code followed by the normalised name —
  /// `dhmeedhoo`. One column covers both halves of the search rule: a
  /// substring of the bare name is also a substring of this, and matching it
  /// is what makes `dh mee` find `Dh. Meedhoo` and `gdh` list that atoll.
  searchQualified String @map("search_qualified")

  /// Invariant 8's soft delete. The register loses islands (depopulation,
  /// consolidation) and a row that has ever been a service area or a booking
  /// location can never be removed. Phase 10b owns the admin action.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceAreas ProviderServiceArea[]

  /// §Phase 8's per-listing areas (ledger P7-3) — a different table from the
  /// account-level one above, and the one discovery matches on.
  listingServiceAreas ListingServiceArea[]

  /// The natural key, so two rows cannot claim the same island of the same atoll.
  @@unique([atollAbbr, name])
  @@index([isActive, name])
  @@index([searchQualified])
  @@map("island")
}

/// The islands a provider works on (§Phase 7).
///
/// Account-level and provider-scoped. Phase 8 gives a *listing* its own
/// service areas, which is what discovery reads; this is the provider's own
/// coverage, and §Phase 6a pre-fills the wizard from it.
model ProviderServiceArea {
  id String @id @default(uuid()) @db.Uuid

  providerProfileId String          @map("provider_profile_id") @db.Uuid
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  islandId String @map("island_id") @db.Uuid
  island   Island @relation(fields: [islandId], references: [id])

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  /// Invariant 8: removing an island from the list clears nothing and deletes
  /// no row — it stamps this, and re-adding the island revives the same row
  /// with a fresh `addedAt`. The unique pair below is what makes that work.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerProfileId, islandId])
  @@index([islandId, removedAt])
  @@map("provider_service_area")
}

// ---------------------------------------------------------------------------
// Phase 8 — service listings
// ---------------------------------------------------------------------------

/// How a listing's price is *calculated* (§Phase 8, Round 16). The plan
/// referred to a per-listing "model" from v4 onward without ever saying what
/// the values were; these five are that enumeration.
///
/// Two of them constrain `bookingMode`: `range` and `quote` force `request`,
/// because §1c requires `agreedAmount` at `accepted` and a slot-mode listing
/// priced `quote` would have the customer booking a fixed time at an unknown
/// price. `ListingService` enforces it on publish and on any write to a
/// published listing.
enum PricingModel {
  fixed
  hourly
  daily
  range
  quote

  @@map("pricing_model")
}

/// What the customer *sees*, separate from how the price is calculated
/// (§Phase 8, Round 16) — `fixed` + `session` renders "MVR 500/session".
///
/// **A closed enum and never free text**, which is the whole of the bullet's
/// stated reason: free text yields `/session`, `/sesion` and `/per session`
/// on three listings, and an enum makes that impossible.
///
/// 🔧 The bullet also says to "seed a short list **per category**", and the
/// plan names no such subset anywhere — §Phase 10b enumerates the editable
/// Category fields without one, and the wizard prototype renders a flat five
/// whatever the category, in a file that *does* key its tag suggestions by
/// category. So there is deliberately no `Category.priceUnits` column: a
/// narrowing invented here would silently block a legitimate provider at
/// publish (ledger row **P8-1**, `docs/decisions/21-phase-8-service-listings.md`).
enum PriceUnit {
  job
  hour
  day
  session
  visit

  @@map("price_unit")
}

/// The wizard axis: a draft is being written, a published listing is live
/// (§Phase 8). Deletion is deliberately **not** a third value — see
/// `Listing.deletedAt`.
enum ListingStatus {
  draft
  published

  @@map("listing_status")
}

/// §1b, enumerated in Round 17. A listing is publicly visible only at
/// `active` **and** `status: 'published'`.
///
/// 🔧 **System-hidden and provider-hidden are deliberately different values.**
/// `hidden_over_cap` is set and cleared **only** by the entitlement system,
/// `hidden_by_provider` **only** by the provider, `hidden_by_admin` only by
/// moderation. Under a single `hidden` value the two are indistinguishable and
/// a paid upgrade would silently republish something the provider had
/// deliberately withdrawn.
enum ListingVisibility {
  active
  hidden_by_provider
  hidden_over_cap
  hidden_by_admin

  @@map("listing_visibility")
}

/// A media object attached to a listing (§Phase 8: "media upload via
/// presigned URL"). Its bytes live in `MediaStorage`, never in the database.
///
/// The row exists from the moment an upload target is issued, which is what
/// makes the object key server-chosen rather than client-supplied — a client
/// naming its own key could overwrite another provider's cover image.
enum ListingMediaStatus {
  /// An upload target has been issued and the bytes have not been finalised.
  pending
  /// The bytes were read back, sniffed, EXIF-stripped and rewritten.
  stored

  @@map("listing_media_status")
}

/// What a `ListingEvent` records (§Phase 8: "view and booking counts come from
/// an event log with periodic rollup, not per-request counter writes").
///
/// Open by intent rather than by accident: §1b's downgrade rule ranks
/// unprotected listings by confirmed bookings over the trailing 90 days and
/// falls back to views, which is a *windowed* question the rollup counters
/// cannot answer on their own — the log is what makes it answerable.
enum ListingEventKind {
  view
  booking

  @@map("listing_event_kind")
}

/// A service listing (§Phase 8).
///
/// **A Listing is not a Provider Profile** (invariant 1). Nothing about who
/// the provider *is* lives here — no phone, no bank details, no verification
/// tier, and no `acceptingNewCustomers`, which §Phase 8 names explicitly as
/// provider-level because Phase 8a's billing pause keys off it.
///
/// **Almost every column is nullable, and that is the requirement**
/// (invariant 2): "a draft must be saveable with zero required fields
/// filled". Only `publish` enforces the six required fields, and it does so in
/// the service — a NOT NULL here would make the draft-save endpoint
/// impossible. `assertPublishable` is the single place that list is written.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  providerProfileId String          @map("provider_profile_id") @db.Uuid
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  /// Nullable for the same reason the rest are: a draft may be saved before a
  /// category is chosen. Required to publish. The *identifier* is the UUID,
  /// never the category name (§Phase 4).
  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id])

  // -- Step 1, Details ------------------------------------------------------

  name             String?
  /// Capped at the wizard's counter. Server-side because invariant 4 puts
  /// every rule here, not only in the client.
  shortDescription String? @map("short_description") @db.VarChar(200)
  longDescription  String? @map("long_description") @db.VarChar(2000)

  /// Round 12's category-scoped chips plus free text underneath, up to ten.
  /// A scalar list rather than a table for the same reason
  /// `Category.occasionPresets` is one: a tag has no identity of its own, is
  /// referenced from nowhere, and the wizard edits the set as a whole.
  tags String[]

  // -- Step 3, Pricing ------------------------------------------------------

  /// §Phase 8: "pricing is per-listing (each listing carries its own model and
  /// rates), not per-provider".
  pricingModel PricingModel? @map("pricing_model")

  /// Integer laari throughout (invariant 7): MVR 150 = 15000. Never a float,
  /// never a decimal-as-string, and never converted to one on the way out.
  /// `priceLaari` carries `fixed` / `hourly` / `daily`; the two range columns
  /// carry `range`; `quote` carries none of them.
  priceLaari    Int? @map("price_laari")
  priceMinLaari Int? @map("price_min_laari")
  priceMaxLaari Int? @map("price_max_laari")

  /// What the customer sees, constrained to the category's seeded list.
  priceUnit PriceUnit? @map("price_unit")

  // -- Step 5, Availability -------------------------------------------------

  /// §1c: defaulted from the category seed, provider-overridable. Nullable
  /// only because a draft may have no category yet to default from; it is set
  /// the moment one is chosen.
  bookingMode BookingMode? @map("booking_mode")

  /// The wizard's simple working window for *this service*. ISO weekday
  /// numbers, 1 = Monday. The recurring availability rules, the slot
  /// generator and time off are §Phase 9a's and are not modelled here.
  workingDays      Int[]   @map("working_days")
  /// `HH:MM`, 24-hour. A string rather than a time column because it is a
  /// recurring wall-clock window with no date, and Maldives is a single
  /// timezone with no DST — reading it back as a `time` would invite a
  /// timezone conversion that has no meaning here.
  workingHoursFrom String? @map("working_hours_from") @db.VarChar(5)
  workingHoursTo   String? @map("working_hours_to") @db.VarChar(5)

  /// §1c's composed emergency rule, listing half. Settable only when the
  /// category is `emergencyCapable` **and** the provider's `verificationTier`
  /// meets that category's `emergencyMinimumTier` — `gold` for Electrical and
  /// Plumbing, `silver` for AC Repair and Moving. Never a boolean `verified`
  /// check and never a hardcoded tier. Enforced on publish and on update, and
  /// re-evaluated when a tier drops (Round 17).
  isEmergency Boolean @default(false) @map("is_emergency")

  // -- Step 6, Extra information -------------------------------------------

  whatsIncluded    String? @map("whats_included") @db.VarChar(1000)
  whatsNotIncluded String? @map("whats_not_included") @db.VarChar(1000)

  /// `[{ question, answer }]`, validated by Zod on the way in and capped
  /// there. Inline for the same reason `tags` is: an FAQ has no identity, is
  /// referenced from nowhere, and step 6 edits the list as a whole.
  faqs Json @default("[]")

  /// §1i, all four self-declared and **none verified by RaajjePro**. None of
  /// them gates publish. Any response carrying them must render as an
  /// attributed claim — "Provider states: 90-day workmanship warranty" — never
  /// as a platform assertion, and never inside the callback badge's visual
  /// treatment.
  warrantyOffered     Boolean @default(false) @map("warranty_offered")
  warrantyTermsText   String? @map("warranty_terms_text") @db.VarChar(500)
  insuranceDeclared   Boolean @default(false) @map("insurance_declared")
  insuranceDetailText String? @map("insurance_detail_text") @db.VarChar(500)

  /// §1h, and per-category since Round 28: opt-in per listing **within an
  /// eligible category**, read from `Category.callbackEligible`. Unlike the
  /// two claims above this one is RaajjePro's promise and is enforced — which
  /// is exactly why it may not be set on a category where nothing was fixed
  /// and so nothing can un-fix.
  callbackGuaranteeOffered Boolean @default(false) @map("callback_guarantee_offered")

  // -- Step 4, Media --------------------------------------------------------

  /// The cover image — required to publish (§0.2 item 4: v4 left it optional,
  /// which meant a listing could go live with a blank thumbnail on every card
  /// and in every search result). Points at one of this listing's own
  /// `ListingMedia` rows; the service checks that before writing it.
  coverMediaId String?       @unique @map("cover_media_id") @db.Uuid
  coverMedia   ListingMedia? @relation("ListingCover", fields: [coverMediaId], references: [id])

  media ListingMedia[] @relation("ListingMedia")

  // -- Step 2, Location -----------------------------------------------------

  /// §Phase 8, ledger row **P7-3**: a listing's own service areas, and these
  /// are what a customer's island filter reads. `ProviderServiceArea` is the
  /// account-level *default* the wizard pre-fills from and nothing more; the
  /// two must never be conflated, and nothing here matches on a name.
  serviceAreas ListingServiceArea[]

  // -- Step 7, Meta ---------------------------------------------------------

  status     ListingStatus     @default(draft)
  visibility ListingVisibility @default(active)

  /// When the listing most recently became published. Cleared by nothing —
  /// hiding a listing changes `visibility`, not this.
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  /// The first time it ever went live. Phase 8a's third trial trigger is
  /// "7 days after a provider's first published listing", which needs the
  /// first moment and not the latest one.
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz(6)

  /// Invariant 8's soft delete. **A timestamp rather than a third
  /// `ListingStatus` value**, because deletion is orthogonal to the wizard
  /// axis: a deleted listing that had been published must still read as
  /// having been published — its bookings and reviews reference it and the
  /// record of what a customer booked cannot become a draft.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// §Phase 8: "view and booking counts come from an event log with periodic
  /// rollup, not per-request counter writes". These are the rollup; the log is
  /// `ListingEvent` and the job that folds one into the other is
  /// `listing-count-rollup`. Reading a count never writes a row.
  viewCount        Int       @default(0) @map("view_count")
  bookingCount     Int       @default(0) @map("booking_count")
  /// The watermark the rollup job counts forward from. Null means nothing has
  /// been rolled up yet.
  countsRolledUpAt DateTime? @map("counts_rolled_up_at") @db.Timestamptz(6)

  events ListingEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// §1a's derived visibility resolves through this composite: the
  /// published-listing count is `(providerProfileId, status, visibility,
  /// deletedAt)` and nothing else, so it is one index scan per provider batch.
  @@index([providerProfileId, status, visibility, deletedAt])
  /// The owner's My Services list, newest first.
  @@index([providerProfileId, deletedAt, updatedAt])
  /// Phase 15's category browse, and the emergency re-evaluation's scan.
  @@index([categoryId, status, visibility])
  @@map("listing")
}

/// The islands **one listing** serves (§Phase 8, ledger row P7-3).
///
/// Keyed on `islandId` and never on a name (§0.0 item 12): sixteen normalised
/// names occur in more than one atoll and `Meedhoo` exists in three, so a
/// service area matched by name would silently serve the wrong atoll.
///
/// Deliberately a separate table from `ProviderServiceArea` rather than a
/// reuse of it. That one is the provider's account-level coverage — §Phase 6a
/// collects it and the wizard pre-fills step 2 from it — and this one is what
/// discovery matches on. A provider whose account default includes an island
/// but whose listing does not is not discoverable for that island, and the
/// listing is what decides.
model ListingServiceArea {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id])

  islandId String @map("island_id") @db.Uuid
  island   Island @relation(fields: [islandId], references: [id])

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  /// Invariant 8, and the same revival pattern `ProviderServiceArea` uses:
  /// removing an island stamps this and re-adding it revives the row.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([listingId, islandId])
  /// Phase 15's island filter reads this direction: which listings serve here.
  @@index([islandId, removedAt])
  @@map("listing_service_area")
}

/// One uploaded image belonging to a listing (§Phase 8).
///
/// The row is created when the upload target is issued, so the storage key is
/// **server-chosen**. A client-supplied key would let one provider overwrite
/// another's cover image, which is the failure a presigned upload most easily
/// invites.
model ListingMedia {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation("ListingMedia", fields: [listingId], references: [id])

  /// Set when this row is the listing's cover. The relation is here so the
  /// foreign key has a back reference; `Listing.coverMediaId` is the truth.
  coverOf Listing[] @relation("ListingCover")

  /// The object key inside `MediaStorage`. Opaque to clients — they receive a
  /// short-lived signed URL, never this.
  objectKey   String @unique @map("object_key")
  contentType String @map("content_type")
  /// The size of the **stored** bytes, which is what is left after EXIF is
  /// stripped, not what the client declared it would upload.
  byteSize    Int?   @map("byte_size")

  status ListingMediaStatus @default(pending)

  /// Gallery order, 0-based. The cover is not part of it — it is named by
  /// `Listing.coverMediaId` — so a listing whose only image is its cover has
  /// an empty gallery rather than a one-item one.
  sortOrder Int? @map("sort_order")

  /// When the bytes were read back, sniffed, EXIF-stripped and rewritten.
  /// Null on a `pending` row, and the honest answer to "has anything actually
  /// been uploaded?".
  storedAt DateTime? @map("stored_at") @db.Timestamptz(6)

  /// Invariant 8. Removing an image stamps this; the object stays in storage,
  /// because a booking or a review may reference the listing as it looked.
  ///
  /// **The provider's action, and only theirs.** Moderation uses the pair
  /// below, for the same reason §1b keeps `hidden_by_provider` and
  /// `hidden_by_admin` apart on a listing: under one field the two are
  /// indistinguishable, and restoring a moderated image would resurrect one
  /// the provider had deliberately taken down.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// 🔧 **Reversible moderation visibility — added 2026-09-10.** `photo` is
  /// one of §Phase 22's six `Report.targetType` values, so an admin must be
  /// able to hide a **single image** of a listing and put it back. §1d:
  /// moderation is always a status flag, never a hard delete — and invariant
  /// 8's soft delete above covers the provider removing an image, not an
  /// admin hiding one.
  ///
  /// Phase 22 owns the action, its required reason and its audit entry;
  /// Phase 8 owns the columns and the filter, which is the same split
  /// §Phase 5 used for `ProviderProfile.suspendedAt`.
  hiddenByAdminAt     DateTime? @map("hidden_by_admin_at") @db.Timestamptz(6)
  hiddenByAdminReason String?   @map("hidden_by_admin_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([listingId, removedAt, hiddenByAdminAt, sortOrder])
  @@map("listing_media")
}

/// The append-only log §Phase 8's counts are rolled up from.
///
/// **Not a per-request counter write.** An `UPDATE listing SET view_count =
/// view_count + 1` on every card impression serialises every reader of a
/// popular listing behind one row lock; an insert here does not. The rollup
/// job folds these into `Listing.viewCount` / `bookingCount` periodically, and
/// the rows stay so that §1b's "confirmed bookings over the trailing 90 days"
/// remains answerable — a counter cannot answer a windowed question.
///
/// No PII (root CLAUDE.md 1d): a listing id, a kind and a time. Deliberately
/// no viewer — nothing in this phase needs one, and a viewer column on an
/// impression log is the kind of thing that is easy to add and hard to justify
/// later.
model ListingEvent {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id])

  kind       ListingEventKind
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// The rollup walks `(occurredAt, id)` forward from each listing's
  /// watermark, so this is the index it reads.
  @@index([listingId, kind, occurredAt])
  @@index([occurredAt])
  @@map("listing_event")
}

// ---------------------------------------------------------------------------
// Phase 8a — Subscription & Trial
// ---------------------------------------------------------------------------

/// What a `PaymentSubmission` is paying for (§Phase 8a, Round 17).
///
/// **The enum stays deliberately open**, and §1b says why: the credit wallet,
/// the advertising module and à la carte purchases are cut post-v1 features
/// that must be able to "slot back in additively". Two values today —
/// `subscription`, which this phase builds, and `emergency_dispatch_fee`,
/// which §1c's MVR 200 customer-side fee uses when §Phase 17.3 lands. The
/// second value is declared here rather than added later so that nothing
/// about the entity assumes the payer is a provider.
enum PaymentPurpose {
  subscription
  emergency_dispatch_fee

  @@map("payment_purpose")
}

/// §Phase 8a. **A `pending` submission grants nothing** — entitlements are
/// identical to no payment at all (§1b), which is the one property of this
/// enum that must never be softened. `getProviderEntitlements` reads the
/// subscription row and never this table, so there is no path by which
/// submitting could activate anything.
///
/// The dispatch fee inverts the reading without changing the values: for
/// `emergency_dispatch_fee`, `pending` is precisely the state that lifts
/// §1c's new-booking block, because the block lifts on proof submission and
/// not on admin confirmation.
enum PaymentSubmissionStatus {
  pending
  confirmed
  rejected

  @@map("payment_submission_status")
}

/// What is unlocked, as opposed to where in its lifecycle a subscription is
/// (§Phase 8a lists `tier` and `status` as separate fields, and they are
/// separate axes: a paused premium subscription is still premium).
///
/// **Not `VerificationTier`.** That one is `none`/`bronze`/`silver`/`gold`,
/// is what the badge renders, and is explicitly NOT affected by subscription
/// state (§1e, §1b: "Badge is unaffected"). Conflating the two is the exact
/// mistake root CLAUDE.md's invariant 1b warns about, so they share no values
/// and no name.
enum SubscriptionTier {
  free
  premium

  @@map("subscription_tier")
}

/// §Phase 8a's five values, and the lifecycle they describe.
///
///   - `trialing` — inside §1b's 30-day trial (Round 12; §0.4's 60 days is
///     superseded by §0.0 item 5). Premium tier.
///   - `active` — a confirmed payment covers the current 30-day period.
///   - `paused` — §1b's pause, capped at 10 cumulative days, shared by
///     `trialing` and `active`. **Tier is unchanged while paused**: pausing
///     stops the billing clock, it is not a downgrade.
///   - `expired` — the period or the trial has ended and §1b's **7-day grace**
///     is running: "7 days after expiry with nothing changing, then downgrade
///     to free". So this status still carries the premium tier, which is
///     counter-intuitive and deliberate — the grace period is *defined* as
///     nothing changing.
///   - `free` — downgraded. The listings over the cap are hidden
///     (`hidden_over_cap`), analytics are off, and one confirmed payment
///     restores everything.
enum SubscriptionStatus {
  trialing
  active
  paused
  expired
  free

  @@map("subscription_status")
}

/// The provider's side of §1b's monetization model — one row per provider,
/// created lazily by whichever comes first: a trial starting or a payment
/// being confirmed.
///
/// **A missing row is not a missing answer.** A provider with no row is on the
/// free tier by definition, which is what `getProviderEntitlements` returns
/// for them, and it is why nothing creates a row on signup.
///
/// **Nothing here is a cache.** §Phase 8a requires `getProviderEntitlements`
/// to be a live database read on every call with no caching, so these columns
/// are the state itself, advanced by the scheduled jobs rather than recomputed
/// per read (backend/CLAUDE.md: "if a transition should happen at a time, a
/// job makes it happen at that time").
model ProviderSubscription {
  id String @id @default(uuid()) @db.Uuid

  providerProfileId String          @unique @map("provider_profile_id") @db.Uuid
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  tier   SubscriptionTier   @default(free)
  status SubscriptionStatus @default(free)

  /// **Never cleared**, which is what makes §1b's "one trial per user account"
  /// enforceable: `startTrial` is a no-op if a trial has *ever* run for this
  /// account. Not keyed on a phone number — §1b is explicit that "a provider
  /// who changes phone keeps their remaining trial", and a phone number below
  /// Bronze proves nothing about who holds it anyway (§1c).
  trialStartedAt DateTime? @map("trial_started_at") @db.Timestamptz(6)
  /// Shifted forward by a pause, exactly as `currentPeriodEnd` is — §1b's
  /// pause has "resume-remaining-time semantics" and applies "the identical
  /// mechanism" to the trial.
  trialEndsAt    DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  /// 🔧 §1b, and **explicitly not a calendar month**: "a subscription bills
  /// every 30 days from an anchor date set at first confirmed payment.
  /// **Pausing shifts the anchor by the paused duration.**" Calling this a
  /// calendar month was incoherent with pause — a provider who pauses four
  /// days is no longer billed on the 1st, and after several pauses no two
  /// providers share an anchor.
  billingAnchorAt  DateTime? @map("billing_anchor_at") @db.Timestamptz(6)
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz(6)

  /// When the current pause began; null when not paused.
  pausedAt DateTime? @map("paused_at") @db.Timestamptz(6)

  /// 🔧 **Minutes, where §Phase 8a's field list says days.** The cap is "10
  /// cumulative days" and the deviation is what makes the cap real: stored as
  /// an integer number of days, a 23-hour pause rounds to zero and can be
  /// repeated forever, which is a hole in a limit rather than a rounding
  /// nicety. One budget of 14,400 minutes, spent at whatever granularity the
  /// provider pauses at. `cumulativePausedDays` and
  /// `remainingPauseAllowanceDays` are both derived from this in the DTO, so
  /// the API still speaks in the days the plan and the billing screen do.
  cumulativePausedMinutes Int @default(0) @map("cumulative_paused_minutes")

  /// One-shot stamps, so a scheduled job that runs every hour sends each
  /// notification once. The alternative — inferring "have I already warned
  /// them?" from the dates — makes the answer depend on how punctually the
  /// job ran, and a provider warned twice about the same expiry stops reading
  /// the warnings.
  /// When §Phase 8a's third trigger nudged this provider toward "Try Premium"
  /// — 🔧 **it prompts and does not start** (decided 2026-09-10). Stamped so
  /// an hourly job sends it once; a row exists for a prompted provider even
  /// though they are still on the free tier, which changes nothing about
  /// their entitlements (an absent row and a `free`/`free` row are the same
  /// answer).
  trialPromptedAt DateTime? @map("trial_prompted_at") @db.Timestamptz(6)

  trialEndingNoticeAt     DateTime? @map("trial_ending_notice_at") @db.Timestamptz(6)
  periodEndingNoticeAt    DateTime? @map("period_ending_notice_at") @db.Timestamptz(6)
  /// When §1b's grace period ran out and the listings over the cap were
  /// hidden. The two win-back notifications are measured from here.
  downgradedAt            DateTime? @map("downgraded_at") @db.Timestamptz(6)
  winbackDay7At           DateTime? @map("winback_day7_at") @db.Timestamptz(6)
  winbackDay30At          DateTime? @map("winback_day30_at") @db.Timestamptz(6)
  /// §1b's introductory rate is "honoured for 12 months from the billing
  /// anchor, then converts to standard with 30 days' notice". This is when
  /// that notice went; the conversion follows 30 days later.
  introductoryNoticeAt    DateTime? @map("introductory_notice_at") @db.Timestamptz(6)
  /// When the introductory rate actually became the standard rate. Kept so
  /// §Phase 10c's conversion trend can tell an intro-cohort provider who
  /// converted from one who never was in the cohort.
  introductoryConvertedAt DateTime? @map("introductory_converted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The lifecycle job scans on status and the three deadlines.
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@index([status, downgradedAt])
  @@map("provider_subscription")
}

/// §1b's manual payment mechanism: "one generic `PaymentSubmission` entity
/// serves every purpose". Provider initiates, app shows the bank details and
/// a generated reference code, provider uploads proof and submits, admin
/// confirms or rejects.
///
/// **Generic in the one way that matters: the payer is a `User`, not a
/// provider.** §1c's MVR 200 emergency dispatch fee is charged to a customer
/// through this same table, so nothing here may assume a provider profile
/// exists. The subscription-specific half — which provider, which period —
/// is resolved by the confirming code, not stored as a second copy here.
///
/// **Nothing is granted by any row in this table.** §1b: "nothing is granted
/// on submission. A `pending` submission produces entitlements identical to no
/// payment at all." Confirmation writes the subscription row; this row records
/// what was claimed and who decided.
model PaymentSubmission {
  id String @id @default(uuid()) @db.Uuid

  /// Who is paying. A user id, because a dispatch-fee payer is a customer.
  payerId String @map("payer_id") @db.Uuid
  payer   User   @relation(fields: [payerId], references: [id])

  purpose PaymentPurpose

  /// Integer laari (invariant 7). Fixed when the submission is created and
  /// never recalculated: it is what the provider was *quoted*, read from
  /// their own `subscriptionPriceLaari` or, before that column is set, from
  /// §1b's cohort rule. Confirming it later at a different number would mean
  /// telling a provider one price and charging another.
  amountLaari Int @map("amount_laari")

  /// The code the provider writes on the transfer and the admin matches
  /// against. Unique across the table — §Phase 10b's search finds a payment
  /// by reference code, and the CSV importer's auto-matching (§Phase 10a)
  /// treats it as an identifier.
  referenceCode String @unique @map("reference_code")

  status PaymentSubmissionStatus @default(pending)

  /// 🔧 **The object key, where §Phase 8a's field list says `proofUrl`.**
  /// §Phase 8's `MediaStorage` hands out short-lived signed read URLs and
  /// re-issues them per read, precisely so an image stops being reachable
  /// when the thing it belongs to does. A stored URL would be a stored
  /// credential with an expiry date in it; the DTO carries `proofUrl`,
  /// derived from this on every read, and `ListingMedia` stores its bytes the
  /// same way for the same reason.
  proofObjectKey   String? @unique @map("proof_object_key")
  proofContentType String? @map("proof_content_type")
  /// The size of the **stored** bytes — what is left after EXIF stripping,
  /// not what the client said it would upload.
  proofByteSize    Int?    @map("proof_byte_size")

  /// 🔧 **Null until the provider actually submits.** §1b's mechanism is four
  /// steps and the row exists from step 1 (the intent, which is what generates
  /// the reference code the provider writes on the transfer), while `pending`
  /// in the admin queue must mean step 3 — proof uploaded and submitted. This
  /// column is the difference, and it is the field §Phase 8a's own list names.
  /// An intent nobody finished is not work for an admin.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  /// The deciding admin. Nullable while pending, and kept after a reversal —
  /// the record of who confirmed a payment survives its reversal.
  reviewedByAdminId String?   @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// Required on rejection (§1b step 4: "rejects (reason required)"), and the
  /// text the provider is shown so they can fix it and resubmit immediately.
  rejectionReason   String?   @map("rejection_reason")

  /// §1b's reversal: "an admin can reverse a confirmed payment (mistake, bank
  /// reversal). Explicit endpoint with an audit-log entry, never a database
  /// edit." Invariant 8 — the row goes back to `rejected` with these stamped,
  /// never deleted.
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversedByAdminId String?   @map("reversed_by_admin_id") @db.Uuid
  reversalReason    String?   @map("reversal_reason")

  invoice Invoice?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The admin pending queue, oldest first (§1b's 48-hour SLA is measured on
  /// `submittedAt`), and the provider's own list of their submissions.
  @@index([purpose, status, submittedAt])
  @@index([payerId, createdAt])
  @@map("payment_submission")
}

/// §1b step 6: "on confirmation, a downloadable **PDF invoice** is generated."
/// §Phase 10a part 1 renders the list and the per-payment download.
///
/// **The bytes are generated once and stored**, not rendered per download. An
/// invoice is a record of what was billed at the time it was issued; a
/// document re-rendered later from live rows would change when the provider
/// edits their business name, which is not what an invoice is.
///
/// Voided rather than deleted when a payment is reversed (invariant 8, §1d).
model Invoice {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable and monotonic, from a Postgres sequence — `RP-000001`.
  /// A count-based number races under concurrent confirmations and would
  /// issue two invoices the same number.
  invoiceNumber String @unique @map("invoice_number")

  providerProfileId String          @map("provider_profile_id") @db.Uuid
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  /// One invoice per confirmed submission. The unique constraint is what makes
  /// a replayed confirmation unable to issue a second one.
  paymentSubmissionId String            @unique @map("payment_submission_id") @db.Uuid
  paymentSubmission   PaymentSubmission @relation(fields: [paymentSubmissionId], references: [id])

  amountLaari Int      @map("amount_laari")
  /// The 30-day period this payment covers, from the billing anchor (§1b).
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  issuedAt    DateTime @map("issued_at") @db.Timestamptz(6)

  /// The stored PDF inside `MediaStorage`. Opaque to clients — they receive a
  /// short-lived signed URL, never this.
  objectKey String @unique @map("object_key")

  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedReason String?   @map("voided_reason")

  @@index([providerProfileId, issuedAt])
  @@map("invoice")
}
