# RaajjePro backend — environment
#
# Strategy
#   - Configuration comes from process environment variables. Nothing else.
#   - Locally, copy this file to `.env` and edit. `.env` is gitignored and is
#     loaded by `node --env-file` (see package.json scripts), by
#     prisma.config.ts and by the test setup (both via dotenv). Nothing reads
#     `.env` in production.
#   - In CI and deployed environments the same variables are injected by the
#     runner / host from its secret store. There is no per-environment file
#     committed anywhere: an `.env.staging` in git is a leaked secret waiting to
#     happen.
#   - Every variable is listed here with a comment and a safe local value, or
#     left empty when there is no safe value. Adding a variable means adding it
#     here in the same commit — this file is the contract for what a deployment
#     must provide. Phase 2's typed config module fails fast on anything missing.
#   - Never commit a real credential to this file. The values below only open
#     the Docker container defined in ../docker-compose.yml.

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection for the app database. Matches ../docker-compose.yml.
DATABASE_URL=postgresql://raajjepro:raajjepro@localhost:5435/raajjepro?schema=public

# The database `npm test` runs against. The suite writes rows and never
# deletes them, so it is fenced off by name: test/setup.ts refuses any
# database whose name does not end in `_test`. Created automatically on a
# fresh Docker volume by infra/postgres/initdb/; on an existing one:
#   docker compose exec db createdb -U raajjepro raajjepro_test
#   DATABASE_URL=<the URL below> npm run db:deploy
TEST_DATABASE_URL=postgresql://raajjepro:raajjepro@localhost:5435/raajjepro_test?schema=public

# --- HTTP server ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace. Redaction applies at every level.
LOG_LEVEL=info
# Believe X-Forwarded-For. Only true behind a proxy you control.
TRUST_PROXY=false

# --- Admin panel (Phase 2 admin identity) -----------------------------------
# The React admin app's origin. CORS allows exactly this origin, with credentials.
# Must be https:// in production.
ADMIN_ORIGIN=http://localhost:5173
# Session controls (plan §Phase 2, Round 12). Idle slides on each request;
# absolute does not. Re-auth is what Phase 10a demands before an ID document.
ADMIN_SESSION_IDLE_MINUTES=15
ADMIN_SESSION_ABSOLUTE_HOURS=12
ADMIN_REAUTH_MINUTES=5
# 32 random bytes, base64. Encrypts TOTP seeds at rest (AES-256-GCM) so a
# database dump does not yield working authenticators. Generate with:
#   openssl rand -base64 32
# The value below is for the local container only.
ADMIN_TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Rate limiting (plan §Phase 2 global tiers) -----------------------------
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=300

# --- User authentication (Phase 3) ------------------------------------------
# 32 random bytes, base64. Signs user access tokens (HS256). Must differ from
# ADMIN_TOTP_ENCRYPTION_KEY. Generate with:  openssl rand -base64 32
# The value below is for the local container only.
AUTH_JWT_SECRET=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
# Access tokens are short-lived; the client refreshes silently. Refresh tokens
# rotate on every use and slide forward this many days (plan §2: per-device).
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
# How long an emailed verification code stays valid. The send and attempt
# limits (3/address/15 min, 5/account/hour, 5 attempts) are plan-pinned
# constants in code, not configuration.
AUTH_OTP_EXPIRY_MINUTES=10
# The forgot-password code (Phase 3b) runs on its own, longer clock — the user
# may have to go and open a mailbox to read it.
AUTH_PASSWORD_RESET_EXPIRY_MINUTES=30

# --- Email (Amazon SES is the only vendor — CLAUDE.md invariant 10) ---------
# file: write each message as JSON into backend/.mail/ (development/test only;
#       refused in production). ses: send through Amazon SES v2.
EMAIL_TRANSPORT=file
EMAIL_FROM_ADDRESS=no-reply@raajjepro.local
# Required when EMAIL_TRANSPORT=ses. Credentials come from the AWS SDK default
# chain (instance role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the
# host environment) — never from this file.
AWS_REGION=
# Three configuration sets, one per channel, so Phase 10b can kill OTP,
# notification and marketing email independently and their reputation
# metrics stay separate.
SES_CONFIGURATION_SET_OTP=
SES_CONFIGURATION_SET_NOTIFICATION=
SES_CONFIGURATION_SET_MARKETING=
# The SNS topic the SES event destinations publish to. The webhook accepts
# notifications from this topic and no other.
SES_EVENTS_TOPIC_ARN=

# --- Push notifications (Phase 3c) -----------------------------------------
# file: write each push as JSON into backend/.push/, the same posture
#       EMAIL_TRANSPORT=file takes.
# fcm_apns: REFUSED. It is the shape the real vendors plug into, and neither
#       exists — there is no Firebase project and no Apple developer account,
#       and Phase 3c deliberately procures neither
#       (docs/decisions/15-phase-3c-push.md). Setting it fails startup with a
#       message saying so, which is better than a deployment quietly believing
#       pushes are going out.
#
# Note what is NOT here: there is no "must be fcm_apns in production" rule to
# match EMAIL_TRANSPORT's. Requiring a transport that is not built would make
# production unbootable rather than safe. The email fallback (§Phase 3c) is
# what carries a notification when push does not.
PUSH_TRANSPORT=file


# --- Media storage (Phase 8) -------------------------------------------------
# Where listing images live, and who signs the upload and read URLs.
#
# file: objects are files under backend/.media/ (gitignored), and this process
#       plays the object store — it signs its own "presigned" URLs and serves
#       PUT /v1/media/uploads/:token and GET /v1/media/:token. The same posture
#       EMAIL_TRANSPORT=file and PUSH_TRANSPORT=file take: the vendor is
#       procured at deployment (§0.0 item 17), the mechanism is built now.
# s3:   REFUSED, exactly like PUSH_TRANSPORT=fcm_apns. No bucket exists and the
#       transport is not written; setting it fails startup rather than letting
#       a deployment believe images are landing somewhere durable
#       (docs/deferred-verification.md L13).
#
# And, copying EMAIL_TRANSPORT's guard rather than half of it: `file` is
# REFUSED IN PRODUCTION. A local directory there is worse than no images —
# they vanish on the next deploy and the provider who uploaded them is never
# told. Together with the line above, production stays unbootable until the
# object store lands, which is the honest signal. Unlike PUSH_TRANSPORT, there
# is no fallback that carries a cover image if the store does not.
MEDIA_STORAGE=file

# The absolute base every signed media URL is built on. Absolute because a real
# object store's URLs point somewhere else entirely, and a client must never
# have to know which transport produced the URL it was handed. Must be https://
# in production.
MEDIA_BASE_URL=http://localhost:3000

# Signs the media tokens. 32 bytes, base64, and it MUST differ from both
# AUTH_JWT_SECRET and ADMIN_TOTP_ENCRYPTION_KEY — the token is the ONLY
# authorization on the upload route, so a key shared with another purpose means
# a signature forged in one context is valid here. Generate with:
#   openssl rand -base64 32
MEDIA_SIGNING_KEY=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=

# --- Billing (Phase 8a) ------------------------------------------------------
# RaajjePro's own bank account: what a provider is shown alongside their
# reference code when they start a subscription payment (§1b step 2), and the
# account Phase 10a's receipt analysis checks a proof against.
#
# Unset in development, which is why the three lines below are commented out —
# the upgrade-request endpoint then returns `bankTransfer: null` and nothing
# invents an account number for a provider to send money to. **All three are
# required in production**, and the app refuses to boot without them.
# BILLING_BANK_NAME=Bank of Maldives
# BILLING_BANK_ACCOUNT_NAME=RaajjePro Pvt Ltd
# BILLING_BANK_ACCOUNT_NUMBER=7770000000000
