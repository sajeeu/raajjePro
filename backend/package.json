{
  "name": "@raajjepro/backend",
  "version": "0.0.0",
  "description": "RaajjePro API — TypeScript / Fastify / Prisma / PostgreSQL",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "jobs:status": "tsx --env-file-if-exists=.env src/jobs/status.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/admin-create.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "otplib": "^13.5.0",
    "pg": "8.23.0",
    "sns-validator": "^0.3.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/sns-validator": "^0.3.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "mysql2": ">=3.24.3",
    "deepmerge-ts": ">=8.0.2"
  }
}
