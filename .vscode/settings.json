{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.rulers": [
    100
  ],
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  },
  "search.exclude": {
    "**/archive/**": true,
    "**/mockups/*.jpg": true,
    "**/.backups/**": true
  },
  "files.associations": {
    "*.dc.html": "html"
  },
  "files.exclude": {
    "**/.eod-push.log": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "CLAUDE.md": "HANDOVER.md, README.md"
  },
  "files.readonlyInclude": {
    "mockups/design-composer/support.js": true,
    "mockups/design-composer/image-slot.js": true
  }
}
